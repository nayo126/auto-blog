---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Reading time estimate: Japanese reads ~600 chars/min, English ~250 words/min
const bodyText = post.body ?? "";
const charCount = bodyText.length;
const readingMinutes = Math.max(1, Math.round(charCount / 600));
---
<Base
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  category={post.data.category}
  tags={post.data.tags}
  image={post.data.image}
  slug={post.id}
>
  <article>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toISOString().slice(0, 10)}
      </time>
      ・ <span>{post.data.category}</span>
      ・ <span>📖 読了{readingMinutes}分</span>
      {post.data.tags.length > 0 && (
        <span>
          {" ・ "}
          {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
        </span>
      )}
    </div>
    <Content />

    <aside style="margin:50px 0; padding:24px; background:linear-gradient(135deg,#0f1a2e 0%,#1a2a4e 100%); color:#fff; border-radius:10px;">
      <div style="font-size:11px; letter-spacing:2px; color:#ffd700; font-weight:700; margin-bottom:8px;">PRODUCT</div>
      <h3 style="font-size:22px; margin:0 0 8px; color:#fff;">AI Prompt Library 2026</h3>
      <p style="margin:0 0 14px; color:#cfd5e2; line-height:1.6;">
        254本の実証済AIプロンプト集。Coding/Marketing/Image/Video等9カテゴリ。105ページのマガジン品質PDF + ボーナス cheat sheet。
      </p>
      <a href={import.meta.env.BASE_URL + "products/promptforge/"} style="display:inline-block; background:#ffd700; color:#0f1a2e; padding:10px 22px; border-radius:6px; font-weight:700; text-decoration:none;">
        商品を見る →
      </a>
    </aside>

    <hr style="margin-top:60px;border:none;border-top:1px solid var(--border)"/>
    <p style="font-size:13px;color:var(--muted)">
      この記事は、AIで稼ぐ高校生が、海外の副業/AIトレンドをまとめたものです。
      <a href={import.meta.env.BASE_URL}>他の記事を見る →</a>
    </p>
  </article>
</Base>
